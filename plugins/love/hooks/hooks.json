{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/format.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/secrets.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/main-guard.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.sh\"",
            "timeout": 300,
            "statusMessage": "love: quick gate"
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/merge-guard.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.sh\"",
            "timeout": 300,
            "statusMessage": "love: quick gate"
          }
        ]
      }
    ]
  }
}
