FROM docker.io/library/debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq gh ripgrep iptables ipset dnsutils sudo \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm install -g pnpm@10

RUN useradd -m -s /bin/bash bot \
 && echo 'bot ALL=(root) NOPASSWD: /usr/local/bin/firewall.sh' > /etc/sudoers.d/firewall
COPY firewall.sh /usr/local/bin/firewall.sh
RUN chmod 755 /usr/local/bin/firewall.sh

USER bot
WORKDIR /home/bot
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH=/home/bot/.local/bin:$PATH \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
